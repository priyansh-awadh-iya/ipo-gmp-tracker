# Twilio API Credentials (from Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Phone Configuration
MY_PHONE_NUMBER=+919876543210
TWILIO_FROM_NUMBER=+14155238886

# Delivery Configuration ('whatsapp', 'sms', or 'telegram')
DELIVERY_METHOD=telegram

# Telegram Credentials (if using telegram delivery method)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Can contain a single chat ID or multiple comma-separated IDs (e.g. 12345678,98765432)
TELEGRAM_CHAT_ID=your_chat_id_here

